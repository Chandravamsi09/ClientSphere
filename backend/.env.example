# ==============================================================================
# ClientSphere CRM - Backend Environment Variables
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-clientsphere-crm-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Target Database Settings (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=clientsphere
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Set to True only for offline development if PostgreSQL instance is not running
USE_SQLITE=False

# CORS Configuration (Development URLs for Flutter Web / Mobile)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
